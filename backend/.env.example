# Railway: use the public MYSQL_URL / DATABASE_URL variable (NOT mysql.railway.internal from your Mac).
PORT=8080
NODE_ENV=production

DATABASE_URL=mysql://user:password@host:3306/railway

JWT_ACCESS_SECRET=change-me-long-random-string
JWT_REFRESH_SECRET=change-me-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Bootstrap super admin (only created if no super_admin exists)
SUPER_ADMIN_EMAIL=you@example.com
SUPER_ADMIN_PASSWORD=use-a-strong-password-here

# Shared Ink Akademi Crew (teacher panel) login, created once if missing
CREW_PORTAL_EMAIL=inkakademicrew@outlook.com
CREW_PORTAL_PASSWORD=set-in-railway-variables-only

# Optional SMTP (registration / password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=inkakademi@noreply.com
SUPPORT_INBOX=inkakademidestek@outlook.com

CORS_ORIGINS=*
DB_POOL_SIZE=20

# Bunny Stream (videos). Library → API: library id + API key.
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
# Library → Delivery: CDN hostname, e.g. vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_STREAM_CDN_HOST=
# Library → Security: enable "Token authentication", paste the token key here.
BUNNY_STREAM_TOKEN_KEY=
# Webhook URL: https://<api-domain>/webhooks/bunny-stream?secret=<BUNNY_WEBHOOK_SECRET>
BUNNY_WEBHOOK_SECRET=

# Bunny Storage (images). Storage zone name + password, plus the connected pull zone.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_CDN_HOST=
# Optional: pull zone → Security → Token authentication key
BUNNY_CDN_TOKEN_KEY=
